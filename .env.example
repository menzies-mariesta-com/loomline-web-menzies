# Drizzle
DATABASE_URL="postgres://user:password@host:port/db-name"

ORIGIN="http://localhost:4001"

# Better Auth
BETTER_AUTH_SECRET=""

# Platform admin seed
SEED_PLATFORM_ADMIN_EMAIL="admin@nextup.local"
SEED_PLATFORM_ADMIN_PASSWORD="NextUpAdmin1!"

# Twilio (optional; console adapter used when unset)
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM_SMS=""

# Cron / outbox
CRON_SECRET="dev-cron-secret"

# Trial requests from /pricing (Soft Wash notification inbox)
TRIAL_REQUEST_INBOX="zarnihlawn@outlook.com"

# SMTP (optional; invite emails log to server console when unset)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM=""

# Neon Object Storage (S3-compatible; org image uploads)
# Pull via `neon env pull` or paste from the Neon console. Never commit real secrets.
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_REGION="us-east-2"
AWS_ENDPOINT_URL_S3=""
# Bucket name from Neon (this project uses `uploads`)
ORG_IMAGE_BUCKET="uploads"
